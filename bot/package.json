{
  "dependencies": {
    "@prisma/client": "^7.9.1",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "knex": "^3.2.10",
    "nodemon": "^3.1.14",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "nodemon --watch . --ext js,ts --exec \"npm run build && node dist/index.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "format": "prettier --write",
    "migrate": "knex migrate:latest"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^26.1.1",
    "dotenv": "^17.4.2",
    "knex-cli": "^1.0.1",
    "prettier": "^3.8.4",
    "prisma": "^7.9.1",
    "typescript": "^7.0.2"
  }
}
